{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug arc-pdf-cli (no args)",
            "cargo": {
                "args": [
                    "build",
                    "--bin=arc-pdf-cli",
                    "--package=arc-pdf-cli"
                ],
                "filter": {
                    "name": "arc-pdf-cli",
                    "kind": "bin"
                },
                "allFeatures": true
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug arc-pdf-app",
            "cargo": {
                "args": [
                    "build",
                    "--bin=arc-pdf-app",
                    "--package=arc-pdf-app"
                ],
                "filter": {
                    "name": "arc-pdf-app",
                    "kind": "bin"
                },
                "allFeatures": true
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}
